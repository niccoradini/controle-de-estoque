{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "controle-estoque",
	"main": "src/worker.js",
	"compatibility_date": "2026-07-15",
	"workers_dev": true,
	"routes": [
		{
			"pattern": "controleestoque.app.br",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "controle-estoque-db",
			"database_id": "91aacc45-e57f-462b-8435-dac8ca42ca11",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}
